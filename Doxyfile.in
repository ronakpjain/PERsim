PROJECT_NAME = "PERsim"
PROJECT_BRIEF = "PER27 3D vehicle plant, AMK devices, FIL firmware, and CM5 CAN bridge"
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/docs"
# API reference only. User documentation is plain Markdown in docs/.
INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/include" \
        "@CMAKE_CURRENT_SOURCE_DIR@/src" \
        "@CMAKE_CURRENT_SOURCE_DIR@/docs/groups.dox" \
        "@CMAKE_CURRENT_SOURCE_DIR@/guest/vcan_bridge.c" \
        "@CMAKE_CURRENT_SOURCE_DIR@/tools"
FILE_PATTERNS = *.hpp *.cpp *.c *.py *.dox
RECURSIVE = YES
EXCLUDE_PATTERNS = */__pycache__/* *.in
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
EXTRACT_ANON_NSPACES = YES
HIDE_UNDOC_MEMBERS = NO
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = NO
WARN_AS_ERROR = FAIL_ON_WARNINGS
WARN_LOGFILE = "@CMAKE_CURRENT_BINARY_DIR@/doxygen-warnings.log"
QUIET = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_TREEVIEW = YES
HTML_COLORSTYLE = DARK
SOURCE_BROWSER = YES
INLINE_SOURCES = NO
USE_MATHJAX = YES
HAVE_DOT = NO
PREDEFINED = PERSIM_WITH_FIL=1
JAVADOC_AUTOBRIEF = YES
OPTIMIZE_OUTPUT_FOR_C = NO
FULL_PATH_NAMES = NO
